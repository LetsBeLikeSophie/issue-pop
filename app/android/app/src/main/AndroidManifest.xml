<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 2026-08-30: 실기기에서 처음 돌려보고 발견함 — 이게 없으면 앱이
         네트워크 자체를 못 써서 모든 API 호출이 "Failed host lookup"
         (DNS 조회 실패)로 보임. 지금까지는 웹 프리뷰로만 테스트해서
         브라우저가 이미 네트워크 권한을 갖고 있으니 못 잡았던 버그. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Issue Pop"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 2026-10-17: 알림 권한 온보딩 — 사용자가 알림에 동의하기 전에는 FCM에 등록(토큰 생성)하지 않음.
             이미 허용한 기기는 앱 시작 때(main.dart의 restorePushIfAllowed) / 동의 직후(getFcmToken)에 다시 켬.
             Firebase 문서가 권하는 대로 분석 수집 자동 설정도 함께 끔(이 앱은 Analytics를 안 씀). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- 2026-10-17: 홈 화면 "관심 종목" 위젯(StockWidgetProvider.kt). 외부 위젯 패키지/WorkManager 없이
             안드로이드 기본 AppWidgetProvider만 씀 — 9월에 home_widget 패키지가 크래시를 일으켜서 걷어냈던 것과
             같은 일이 없게 하려고. 위젯에 보일 종목은 앱의 관심 종목 화면에서 정함(MainActivity의 채널). -->
        <!-- 2026-10-18: 같은 방식으로 만든 위젯 두 개 더 — 오늘의 이슈(IssueWidget.kt), 오늘의 단어(WordWidget.kt). 위젯 목록에서
             "Issue Pop" 아래에 종류별로 따로 보임. -->
        <!-- 위젯 주기 갱신/네트워크 복구 재시도용 JobScheduler 작업(WidgetRefresh.kt). WorkManager가 아니라 프레임워크 API. -->
        <service
            android:name=".WidgetRefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".IssueWidgetProvider" android:exported="true" android:label="오늘의 이슈">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/issue_widget_info"/>
        </receiver>
        <receiver android:name=".WordWidgetProvider" android:exported="true" android:label="오늘의 단어">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_widget_info"/>
        </receiver>
        <receiver android:name=".StockWidgetProvider" android:exported="true" android:label="관심 종목">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_widget_info"/>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
