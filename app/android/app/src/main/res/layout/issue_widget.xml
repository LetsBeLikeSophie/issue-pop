<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-18: "오늘의 이슈" 위젯 — 관심 종목 위젯과 같은 톤(흰 카드 + 얇은 라인 + 남색 가는 선 하나). 오늘 가장 많이 보도된 이슈를
     [순위] [대표 키워드 · 보조 키워드] [기사 수] / 아랫줄 대표 헤드라인으로 최대 5개(높이만큼만 보임, IssueWidgetData.visibleRows).
     RemoteViews가 허용하는 뷰(LinearLayout/FrameLayout/TextView)만 씀. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stock_widget_bg"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="9dp"
    android:paddingEnd="13dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Issue "
            android:textColor="@color/sw_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/stock_widget_highlight"
            android:fontFamily="serif"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text="Pop"
            android:textColor="#14161C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="오늘의 이슈"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/iw_header_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 남색은 이 가는 선에만. RemoteViews는 일반 View를 못 써서 FrameLayout으로 그림. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="@color/sw_accent" />

    <TextView
        android:id="@+id/iw_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="불러오는 중…"
        android:textColor="@color/sw_ink_soft"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/iw_r1"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/iw_r1_rank"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/sw_ink_faint"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iw_r1_kw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/sw_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/iw_r1_sub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:textColor="@color/sw_ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/iw_r1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:textColor="@color/sw_ink_faint"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/iw_r1_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="@color/sw_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
