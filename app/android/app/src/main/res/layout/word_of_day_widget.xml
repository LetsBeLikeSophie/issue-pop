<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/word_of_day_widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘의 단어"
        android:textColor="#9A9CA3"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- word_of_day_widget.dart의 _HighlightedWord를 renderFlutterWidget()으로
         그려서 저장한 PNG — 형광펜 효과는 순수 RemoteViews로 표현할 수
         없어서 이미지로 미리 그려 넘김. 데이터가 아직 없으면(첫 배치 직후)
         숨겨둠. -->
    <ImageView
        android:id="@+id/widget_word_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_definition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#4B4D55"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
