<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-17: 관심 종목 위젯 — 머리글(제목 / 시세 시각) + 얇은 구분선 + 종목 최대 3줄
     (티커 · 이름 | 달러 · 원화 | 등락률 알약). StockWidgetData.buildViews 참고. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stock_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="관심 종목"
            android:textColor="@color/sw_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sw_header_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 구분선. RemoteViews(위젯)는 허용된 뷰만 쓸 수 있어서 일반 View는 "위젯을 추가할 수 없음"으로 실패함
         (+11에서 겪음) — 허용 목록에 있는 FrameLayout으로 그림. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/sw_line" />

    <TextView
        android:id="@+id/sw_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="불러오는 중…"
        android:textColor="@color/sw_ink_soft"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/sw_r1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sw_r1_ticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:minWidth="40dp"
            android:textColor="@color/sw_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sw_r1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/sw_r1_usd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/sw_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sw_r1_krw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/sw_r1_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="46dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sw_r2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sw_r2_ticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:minWidth="40dp"
            android:textColor="@color/sw_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sw_r2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/sw_r2_usd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/sw_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sw_r2_krw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/sw_r2_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="46dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sw_r3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sw_r3_ticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:minWidth="40dp"
            android:textColor="@color/sw_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sw_r3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="6dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/sw_r3_usd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/sw_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sw_r3_krw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/sw_r3_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="46dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
