<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-18: "오늘의 단어" 위젯 — 단어를 크게(아래쪽 절반에 노란 형광펜), 그 아래 뜻풀이, 예문은 작게. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stock_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="5dp"
    android:paddingEnd="13dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Issue "
            android:textColor="@color/sw_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/stock_widget_highlight"
            android:fontFamily="serif"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text="Pop"
            android:textColor="#14161C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="오늘의 단어"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/ww_header_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 남색은 이 가는 선에만. RemoteViews는 일반 View를 못 써서 FrameLayout으로 그림. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="@color/sw_accent" />

    <TextView
        android:id="@+id/ww_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="불러오는 중…"
        android:textColor="@color/sw_ink_soft"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/ww_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/ww_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/word_widget_highlight"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@color/sw_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ww_definition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingTop="7dp"
            android:textColor="@color/sw_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ww_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingTop="5dp"
            android:textColor="@color/sw_ink_faint"
            android:textSize="10.5sp" />
    </LinearLayout>
</LinearLayout>
